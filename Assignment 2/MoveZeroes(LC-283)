<!-- Move Zeroes — #283 Move all 0s to the end while maintaining the relative order of non-zero elements. -->

class Solution {
    public void moveZeroes(int[] nums) {
        int j = 0;
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
               
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;
                j++;   
            }
        }
    }
}
